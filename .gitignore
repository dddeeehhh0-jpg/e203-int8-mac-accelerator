# Generated by the regression; reproducible, do not commit
build/
*.vvp
*.vcd
vectors/gen/*
!vectors/gen/.gitkeep
!vectors/gen/manifest.csv
results/dump_*.csv
results/tb_*.log
results/gl_dump_*.csv
results/gl_rtl_dump_*.csv
results/gl_tb_*.log
results/dc_*.rpt
# lint_report.txt, parse_report.txt, regression_summary.md,
# synthesis_report.md, gatelevel_report.md, ci_evidence.md and
# vectors/gen/manifest.csv are deliberately NOT ignored: they are this host's
# evidence snapshot and README/docs link to them. The scripts regenerate the
# generated ones on every run; CI uploads its own copies as artifacts.
syn/out/
__pycache__/
*.pyc
parser.out
parsetab.py

# Formal verification run products (regenerated on every run; CI artifact)
formal/out/

# Local tooling (never part of the portfolio)
.tools/

# ---- Contest / third-party material: HARD EXCLUSION ----
# No PDK, no netlist, no SRAM macro, no weights, no dataset, no server paths.
*.lib
*.db
*.lef
*.def
*.gds
*.gds2
*.saif
*.sdf
pdk/
libs/
weights/
dataset/
speech_commands*/
*.wav
*.mp3
*.tar
*.tar.gz
*.tgz
*_dc_report*
*_screenshot*
server_*/
